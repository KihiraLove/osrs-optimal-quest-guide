{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quest-optimizer:manifest:0.1.0",
  "title": "Quest optimizer manifest draft contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "dataset_id": {
      "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "synthetic",
        "reviewed"
      ]
    },
    "coverage_status": {
      "enum": [
        "incomplete",
        "synthetic",
        "complete"
      ]
    },
    "game_revision": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "coverage_ledger": {
      "type": "string",
      "minLength": 1
    },
    "release_profile": {
      "type": "string",
      "minLength": 1
    },
    "collections": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "activities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "travel_edges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "xp_rewards": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "combat_formulas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "sources",
        "skills",
        "locations",
        "tokens",
        "items",
        "activities",
        "actions",
        "travel_edges",
        "xp_rewards"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "status",
    "coverage_status",
    "game_revision",
    "as_of",
    "collections"
  ],
  "additionalProperties": false
}
