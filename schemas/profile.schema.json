{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quest-optimizer:profile:0.1.0",
  "title": "Quest optimizer profile draft contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "profile_id": {
      "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
    },
    "dataset_id": {
      "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "synthetic",
        "reviewed"
      ]
    },
    "account_type": {
      "const": "main"
    },
    "members": {
      "type": "boolean"
    },
    "objective": {
      "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/objective_order"
    },
    "policies": {
      "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/policies"
    },
    "initial_state": {
      "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/state"
    },
    "goal_action_ids": {
      "type": "array",
      "items": {
        "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "priority_action_ids": {
      "type": "array",
      "items": {"$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"},
      "minItems": 1,
      "uniqueItems": true
    },
    "priority_skill_levels": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"},
      "additionalProperties": {"type": "integer", "minimum": 2}
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "dataset_id",
    "dataset_version",
    "status",
    "account_type",
    "members",
    "objective",
    "policies",
    "initial_state",
    "goal_action_ids",
    "assumptions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"required": ["priority_action_ids"]},
      "then": {"properties": {"objective": {"contains": {"const": "priority_elapsed_seconds"}}}},
      "else": {"properties": {"objective": {"not": {"contains": {"const": "priority_elapsed_seconds"}}}}}
    },
    {
      "if": {"required": ["priority_skill_levels"]},
      "then": {"properties": {"objective": {"contains": {"const": "priority_skill_elapsed_seconds"}}}},
      "else": {"properties": {"objective": {"not": {"contains": {"const": "priority_skill_elapsed_seconds"}}}}}
    }
  ]
}
