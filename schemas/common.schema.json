{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quest-optimizer:common:0.1.0",
  "title": "Quest optimizer common draft contract",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "unverified",
            "verified",
            "estimated",
            "synthetic"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_ids",
        "status",
        "note"
      ],
      "additionalProperties": false
    },
    "duration": {
      "type": "object",
      "properties": {
        "min_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "expected_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "min_seconds",
        "expected_seconds",
        "max_seconds"
      ],
      "additionalProperties": false
    },
    "requirement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "all",
                "any"
              ]
            },
            "requirements": {
              "type": "array",
              "items": {
                "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/requirement"
              }
            }
          },
          "required": [
            "kind",
            "requirements"
          ],
          "additionalProperties": false,
          "if": {
            "properties": {
              "kind": {
                "const": "any"
              }
            }
          },
          "then": {
            "properties": {
              "requirements": {
                "minItems": 1
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "skill"
            },
            "skill_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "minimum_level": {
              "type": "integer",
              "minimum": 1
            },
            "boostable": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "skill_id",
            "minimum_level",
            "boostable"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "action_completed"
            },
            "action_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            }
          },
          "required": [
            "kind",
            "action_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "flag"
            },
            "token_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "token_id",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "counter"
            },
            "token_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "minimum": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "token_id",
            "minimum"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "item"
            },
            "item_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "item_id",
            "quantity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "policy"
            },
            "name": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "value": {
              "type": [
                "string",
                "boolean",
                "integer"
              ]
            }
          },
          "required": [
            "kind",
            "name",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "combat_level"
            },
            "formula_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "minimum_level": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "formula_id",
            "minimum_level"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "elapsed_time"
            },
            "minimum_seconds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "minimum_seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cooldown_ready"
            },
            "token_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            }
          },
          "required": [
            "kind",
            "token_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "choice"
            },
            "token_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "option": {
              "anyOf": [
                {
                  "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "token_id",
            "option"
          ],
          "additionalProperties": false
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "xp"
            },
            "skill_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "xp_tenths": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "skill_id",
            "xp_tenths"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "flag"
            },
            "token_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "token_id",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "counter"
            },
            "token_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "delta": {
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "token_id",
            "delta"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "item"
            },
            "item_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "item_id",
            "quantity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "xp_reward"
            },
            "reward_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "reward_id",
            "quantity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "skill_boost"
            },
            "skill_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "bonus_levels": {
              "type": "integer",
              "minimum": 1
            },
            "duration_seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "skill_id",
            "bonus_levels",
            "duration_seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "start_cooldown"
            },
            "token_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "duration_seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "token_id",
            "duration_seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "choose"
            },
            "token_id": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            },
            "option": {
              "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
            }
          },
          "required": [
            "kind",
            "token_id",
            "option"
          ],
          "additionalProperties": false
        }
      ]
    },
    "item_amount": {
      "type": "object",
      "properties": {
        "item_id": {
          "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "item_id",
        "quantity"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "location_id": {
          "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
        },
        "xp_tenths": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "completed_action_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
          },
          "uniqueItems": true
        },
        "flags": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "counters": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "inventory": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "held_rewards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instance_id": {
                "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
              },
              "reward_id": {
                "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
              },
              "remaining_picks": {
                "type": "integer",
                "minimum": 1
              },
              "used_skill_ids": {
                "type": "array",
                "items": {
                  "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "instance_id",
              "reward_id",
              "remaining_picks"
            ],
            "additionalProperties": false
          }
        },
        "modeled_elapsed_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "active_boosts": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "bonus_levels": {
                "type": "integer",
                "minimum": 1
              },
              "expires_at_seconds": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "bonus_levels",
              "expires_at_seconds"
            ],
            "additionalProperties": false
          }
        },
        "cooldowns": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "choices": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
          }
        },
        "action_counts": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 2
          }
        },
        "travel_counts": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "required": [
        "location_id",
        "xp_tenths",
        "completed_action_ids",
        "flags",
        "counters",
        "inventory",
        "held_rewards",
        "modeled_elapsed_seconds"
      ],
      "additionalProperties": false
    },
    "objective_order": {
      "enum": [
        ["manual_training_xp_tenths", "modeled_non_training_seconds", "stable_step_ids"],
        ["manual_training_xp_tenths", "priority_elapsed_seconds", "modeled_non_training_seconds", "stable_step_ids"],
        ["counted_manual_training_xp_tenths", "priority_skill_elapsed_seconds", "modeled_non_training_seconds", "stable_step_ids"],
        ["counted_manual_training_xp_tenths", "priority_skill_elapsed_seconds", "priority_elapsed_seconds", "modeled_non_training_seconds", "stable_step_ids"]
      ]
    },
    "policies": {
      "type": "object",
      "properties": {
        "quest_lamp_skill_policy": {
          "enum": [
            "any_skill",
            "observed"
          ]
        },
        "trade_enabled": {
          "const": true
        },
        "gp_policy": {
          "enum": ["sufficient", "self_funded"]
        },
        "allow_boosts": {
          "type": "boolean"
        },
        "allow_poh_services": {
          "type": "boolean"
        },
        "world": {
          "type": "integer",
          "minimum": 300
        },
        "allow_wilderness_travel": {
          "type": "boolean"
        },
        "allow_death_travel": {
          "type": "boolean"
        },
        "allow_minigame_teleports": {
          "type": "boolean"
        },
        "allow_world_switching": {
          "type": "boolean"
        },
        "allow_player_assistance": {
          "type": "boolean"
        },
        "allow_repeatable_xp": {
          "const": false
        },
        "training_methods": {
          "const": "user_choice"
        },
        "training_time_in_objective": {
          "const": false
        },
        "training_resume_policy": {
          "const": "return_to_route_waypoint"
        }
      },
      "required": [
        "quest_lamp_skill_policy",
        "trade_enabled",
        "gp_policy",
        "allow_boosts",
        "allow_poh_services",
        "allow_wilderness_travel",
        "allow_death_travel",
        "allow_minigame_teleports",
        "allow_world_switching",
        "allow_player_assistance",
        "allow_repeatable_xp",
        "training_methods",
        "training_time_in_objective",
        "training_resume_policy"
      ],
      "additionalProperties": false
    },
    "xp_map": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:quest-optimizer:common:0.1.0#/$defs/id"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    }
  }
}
